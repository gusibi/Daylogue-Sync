{
  "name": "daylogue-sync",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "wrangler dev",
    "deploy": "wrangler deploy",
    "pages:deploy": "wrangler pages deploy .svelte-kit/cloudflare --project-name daylogue-sync",
    "test": "vitest run",
    "db:migrate:local": "wrangler d1 migrations apply daylogue-sync --local",
    "db:seed:local": "node scripts/seed-local.js",
    "local": "wrangler d1 migrations apply daylogue-sync --local && vite build && wrangler dev --port 8787"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "4.20260702.1",
    "@sveltejs/adapter-cloudflare": "^4.8.0",
    "@sveltejs/kit": "^2.16.0",
    "@sveltejs/vite-plugin-svelte": "^4.0.0",
    "@types/node": "^22.20.5",
    "autoprefixer": "^10.4.20",
    "miniflare": "3.20250718.3",
    "postcss": "^8.4.49",
    "svelte": "^5.16.0",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.2",
    "vite": "^5.4.11",
    "vitest": "^2.1.8",
    "wrangler": "^3.99.0"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "lucide-svelte": "^0.468.0",
    "tailwind-merge": "^2.5.5",
    "zod": "^3.24.1"
  }
}
